{
  "name": "silk-support-mailer",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  // Reachable only through the docs site's service binding: no public URL.
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [
    {
      "name": "EMAIL",
      // The binding refuses any other sender, whatever the caller asks for.
      "allowed_sender_addresses": ["support@heysilkai.com"]
    }
  ],
  "vars": {
    // Inbound mail is handed to this site's /api/inbound (secret: INBOUND_SECRET).
    "SITE_URL": "https://support.heysilkai.com",
    // A verified Email Routing destination: gets the original when the site
    // can't take a message, or when it has attachments the portal won't store.
    "FALLBACK_FORWARD": "ijuwebdesk@gmail.com"
  },
  "observability": { "enabled": true }
}
