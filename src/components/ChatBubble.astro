---
/**
 * The floating "Ask Silk" button on every docs page. It opens the support
 * chat in a panel (full screen on phones). The chat code loads on first
 * open, so pages that never use it don't pay for it. Not shown on /support,
 * which is the chat already, or on the admin.
 */
import SupportChat from './SupportChat.astro'

const path = Astro.url.pathname
const show = !path.startsWith('/support') && !path.startsWith('/admin')
---

{
  show && (
    <div class="bubble" data-bubble>
      <div class="panel" id="ask-silk-panel" role="dialog" aria-label="Ask Silk" data-panel hidden>
        <header class="panel-head">
          <div class="panel-title">
            <strong>Ask Silk</strong>
            <span>Answers from the Silk docs</span>
          </div>
          <a class="panel-icon" href="/support/" title="Open full page" aria-label="Open the chat as a full page">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" />
            </svg>
          </a>
          <button type="button" class="panel-icon" data-close aria-label="Close">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </header>
        <div class="panel-body">
          <SupportChat variant="panel" />
        </div>
      </div>

      <button type="button" class="launcher" data-launcher aria-expanded="false" aria-controls="ask-silk-panel">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 3C6.5 3 2 6.9 2 11.7c0 2.4 1.1 4.6 3 6.2-.2 1.3-.8 2.5-1.7 3.4a.5.5 0 0 0 .4.8c2 0 3.7-.8 4.9-1.7 1.1.3 2.2.5 3.4.5 5.5 0 10-3.9 10-8.7S17.5 3 12 3Z"
          />
        </svg>
        <span>Ask Silk</span>
      </button>
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-bubble]')
  if (root) {
    // Rendered inside the footer, whose ancestors form a stacking context that
    // the fixed right sidebar paints over. At the top level it floats above all.
    document.body.append(root)
    const panel = root.querySelector<HTMLElement>('[data-panel]')!
    const launcher = root.querySelector<HTMLButtonElement>('[data-launcher]')!
    let ready: Promise<void> | null = null

    function setOpen(open: boolean) {
      panel.hidden = !open
      launcher.setAttribute('aria-expanded', String(open))
      root!.toggleAttribute('data-open', open)
      if (!open) return launcher.focus()
      // Load the chat (markdown renderer and all) only when someone wants it.
      ready ??= import('../support/chat').then(({ initSupportChat }) =>
        initSupportChat(panel.querySelector<HTMLElement>('[data-support]')!),
      )
      ready.then(() => panel.querySelector<HTMLTextAreaElement>('[data-input]')?.focus())
    }

    launcher.addEventListener('click', () => setOpen(panel.hidden))
    root.querySelector('[data-close]')!.addEventListener('click', () => setOpen(false))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false)
    })
  }
</script>

<style>
  .bubble {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.15rem 0.8rem 1rem;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    color: var(--silk-ivory);
    background: linear-gradient(135deg, #8b7bff 0%, #6f5bf5 100%);
    box-shadow:
      0 10px 28px -6px color-mix(in srgb, #6f5bf5 60%, transparent),
      0 2px 6px rgb(0 0 0 / 0.2);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease;
  }
  .launcher:hover {
    transform: translateY(-2px);
  }
  .launcher:focus-visible {
    outline: 3px solid var(--silk-cyan);
    outline-offset: 3px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    width: min(26rem, calc(100vw - 2.5rem));
    height: min(40rem, calc(100vh - 7rem));
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-black);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.45);
  }
  .panel[hidden] {
    display: none;
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.75rem 0.75rem 1rem;
    color: var(--silk-ivory);
    background: linear-gradient(135deg, #8b7bff 0%, #6f5bf5 100%);
  }
  .panel-title {
    display: flex;
    flex-direction: column;
    flex: 1;
    line-height: 1.25;
  }
  .panel-title span {
    font-size: 0.8rem;
    opacity: 0.85;
  }
  .panel-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: none;
    border-radius: 0.5rem;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .panel-icon:hover {
    background: rgb(255 255 255 / 0.15);
    color: inherit;
  }
  .panel-body {
    flex: 1;
    min-height: 0;
  }

  /* Phones: the panel takes the whole screen, and its close button replaces the launcher. */
  @media (max-width: 40rem) {
    .bubble {
      right: 1rem;
      bottom: 1rem;
    }
    .bubble[data-open] {
      inset: 0;
    }
    .bubble[data-open] .launcher {
      display: none;
    }
    .panel {
      width: 100%;
      height: 100%;
      border: none;
      border-radius: 0;
    }
  }

  @media print {
    .bubble {
      display: none;
    }
  }
</style>
