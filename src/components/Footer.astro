---
// Starlight's footer, plus "Was this page helpful?" on docs articles and the
// floating "Ask Silk" chat bubble everywhere. The footer is the one component
// every page renders, so both ride along with it.
import Default from '@astrojs/starlight/components/Footer.astro'
import ArticleFeedback from './ArticleFeedback.astro'
import ChatBubble from './ChatBubble.astro'

// Articles only: not the splash pages (home, chat, admin).
const isArticle = Astro.locals.starlightRoute.entry.data.template === 'doc'
---

{isArticle && <ArticleFeedback />}
<Default {...Astro.props}><slot /></Default>
<ChatBubble />
