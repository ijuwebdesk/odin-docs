---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import SupportChat from '../components/SupportChat.astro'
---

<StarlightPage
  frontmatter={{
    title: 'Ask Silk',
    description: 'Get answers about Silk from the docs, or reach the Silk team.',
    template: 'splash',
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <SupportChat variant="page" />
</StarlightPage>

<script>
  import { initSupportChat } from '../support/chat'
  initSupportChat(document.querySelector<HTMLElement>('[data-support]')!)
</script>
